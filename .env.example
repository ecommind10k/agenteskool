# Skool credentials
SKOOL_EMAIL=tu@email.com
SKOOL_PASSWORD=tu_password

# Anthropic API key (get it at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: output directory for PDFs (default: ./output)
OUTPUT_DIR=./output

# Optional: language for summaries (default: es for Spanish)
SUMMARY_LANGUAGE=es

# Optional: Whisper model size for audio transcription fallback
# Choices: tiny, base, small, medium, large (larger = more accurate but slower)
WHISPER_MODEL=base
